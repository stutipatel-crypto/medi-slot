# Environment variable example for Medi Slot
# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control.

# REQUIRED in production — use a long random string
SECRET_KEY=replace-this-with-a-long-random-secret

# Set to "true" only when running behind HTTPS
SESSION_COOKIE_SECURE=false

# Booking mode: "demo" (default) or "live" (requires clinic authorisation)
BOOKING_MODE=demo

# Queue mode: "demo" (default)
QUEUE_MODE=demo

# How many patients trigger a notification warning
QUEUE_NOTIFICATION_THRESHOLD=4

# Assumed minutes per appointment (demo calculations only)
DEFAULT_APPOINTMENT_DURATION_MINUTES=15

# Simulated patients ahead for demo queue
DEMO_PATIENTS_AHEAD_DEFAULT=3

# Flask debug mode — set to "false" in production
FLASK_DEBUG=true
